<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textBetaChecksTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_beta_checks_enabled"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_beta_checks_enabled_desc"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchBetaChecks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/betaChildChecks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/SettingsGroupCard"
                android:layout_marginBottom="8dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchBetaHookTiming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:padding="16dp"
                    android:text="@string/settings_beta_hook_timing" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/SettingsGroupCard"
                android:layout_marginBottom="8dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchBetaHiddenAndroidApis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:padding="16dp"
                    android:text="@string/settings_beta_hidden_android_apis" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/SettingsGroupCard"
                android:layout_marginBottom="8dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchBetaKernelNetlink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:padding="16dp"
                    android:text="@string/settings_beta_kernel_netlink" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/SettingsGroupCard"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchBetaPrivilegedChecks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:padding="16dp"
                        android:text="@string/settings_beta_privileged_checks" />

                    <RadioGroup
                        android:id="@+id/groupBetaPrivilegedProvider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <RadioButton
                            android:id="@+id/radioBetaProviderShizuku"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_beta_provider_shizuku" />

                        <RadioButton
                            android:id="@+id/radioBetaProviderRoot"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_beta_provider_root" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/SettingsGroupCard"
                android:layout_marginBottom="8dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchBetaSocketOracles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:padding="16dp"
                    android:text="@string/settings_beta_socket_oracles" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/SettingsGroupCard"
                android:layout_marginBottom="8dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchBetaProfileIsolation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:padding="16dp"
                    android:text="@string/settings_beta_profile_isolation" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/SettingsGroupCard"
                android:layout_marginBottom="8dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchBetaSandboxIntegrity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:padding="16dp"
                    android:text="@string/settings_beta_sandbox_integrity" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/SettingsGroupCard"
                android:layout_marginBottom="8dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchBetaBpfNetfilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:padding="16dp"
                    android:text="@string/settings_beta_bpf_netfilter" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/SettingsGroupCard">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchBetaAggressiveScan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:padding="16dp"
                    android:text="@string/settings_beta_aggressive_scan" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
